!ifdef DEBUG {
    !warn "bytes wasted: ", IRQ-*
}

!if SPRITES = 0 {
!macro increment_vic_ctrl_y {
    lda VIC_CTRL_Y                       ;  4
    clc                                     ;  2
    adc #1                                  ;  2
    and #%00000111                          ;  2
    adc #CTRL_Y_INVALID                  ;  2
    sta VIC_CTRL_Y                       ;  4
}                                           ;--> 16
} else {
increment_vic_ctrl_y !zone {
    lda VIC_CTRL_Y                       ;  4
    clc                                     ;  2
    adc #1                                  ;  2
    and #%00000111                          ;  2
    adc #CTRL_Y_INVALID                  ;  2
    sta VIC_CTRL_Y                       ;  4

    rts                                     ;  6
}                                           ;--> 22
}

!align 255, 0
IRQ !zone {
;-------------------------------------------------------------------------------
;   LINE_0
;-------------------------------------------------------------------------------

    ; irq event                             ;  7
    ; last instruction                      ;  1 (min)
    sta restore_registers + 1                    ;  4
    stx restore_registers + 3                    ;  4
    sty restore_registers + 5                    ;  4

    lda VIC_RASTER                          ;  4
    cmp #LINE_0                             ;  2
    beq +                                   ;  3
    jam
+                                           ;--> 29
    ; ack interrupt
    inc VIC_IRQ_STATUS                      ;  6

    inc VIC_RASTER                          ;  6
    +set16 .irq_line_0_plus_1, VECTOR_IRQ   ; 12
                                            ;--> 24

    ; save stack state
    tsx                                     ;  2
    ; begin raster stabilization
    cli                                     ;  2
                                            ;--> 4

    ; somewhere here the next interrupt will hit
    +wait_even 63 - 29 - 24 - 4

;-------------------------------------------------------------------------------
;   LINE_0 + 1
;-------------------------------------------------------------------------------
.irq_line_0_plus_1
    ; irq event                             ;  7
    ; last instruction                      ;1-2 (because of the nop field above)
    ; restore stack state
    txs                                     ;  2
                                            ;--> 10-11

    ; calculate the number of nops to skip in VSP
    lda #SCREEN_COLS-1                         ;  2
    sec                                     ;  2
HARD_X = *+1
    sbc #HARD_X_INIT                        ;  2
    lsr                                     ;  2
    sta .self_modifying_branch__nops + 1    ;  4
                                            ;--> 12

    ; introduce an extra cycle in VSP if carry is set
    bcs .set_bcc                            ;2-3
.set_bcs
    ldx #BCS_OPCODE                         ;  2
    bne +   ; always true                   ;  3
.set_bcc
    ldx #BCC_OPCODE                         ;  2
    nop     ; make this path as long        ;  2
+
    stx .self_modifying_branch__lsb         ;  4
                                            ;--> 11

    ; set up soft scroll
    lda #CTRL_X                          ;  2
    clc                                     ;  2
SOFT_X = *+1
    adc #0                                  ;  2
    sta VIC_CTRL_X                       ;  4
                                            ;--> 10

    +wait 63-11-12-11-10-6

    ; wobble check
    lda #LINE_0 + 2                         ;  2
    cmp VIC_RASTER                          ;  4
                                            ;--> 6
    +bne                                    ;3-2
    ; -> the raster interrupt is stable now with 3 cycles off

;-------------------------------------------------------------------------------
;   LINE_0 + 2
;-------------------------------------------------------------------------------

    ; wobble check from above               ;-->  3

    ; make FIRST_BADLINE a bad line
!if SPRITES = 0 {
    lda #CTRL_Y_INVALID                  ;  2
} else {
    lda CTRL_Y_INVALID_COPY                      ;  3
}
    sta VIC_CTRL_Y                       ;  4
                                            ;--> 6/7

    lda #SCREEN_ROWS                           ;  2
    sec                                     ;  2
HARD_Y = *+1
    sbc #HARD_Y_INIT                        ;  2
    tax                                     ;  2
                                            ;-->  8

    ; pre-compute VIC_CTRL_Y value for soft-scrolling
    lda #7 + (SCREEN_ROWS+1) % 8               ;  2
    sec                                     ;  2
SOFT_Y = *+1
    sbc #0                                  ;  2

    and #%00000111                          ;  2
    ora #CTRL_Y_INVALID                  ;  2
    ; spill pre-computed value
    pha                                     ;  3
                                            ;--> 13/14

!if SPRITES = 0 {
    +wait_loop 63 - 3 - 6 - 8 - 13 - 20 - 4
}

;-------------------------------------------------------------------------------
;   FLD & line crunch
;-------------------------------------------------------------------------------

.fld_loop
    cpx #0                                  ;  2
    beq +                                   ;  2 (in this loop)

!if SPRITES = 0 {
    +increment_vic_ctrl_y                      ; 16
    +wait_loop 63 - 20 - 2 - 3
} else {
    jsr increment_vic_ctrl_y              ; 22 + 6 (jsr)
    lda VIC_RASTER                          ;  4
    cmp #SPRITES_TOP_Y                      ;  2
    bcs .sprite_rows_fld_wait               ;  2/3
    +wait_loop 63 - 32 - 2 - 3 - 4 - 2 - 2
}

    dex                                     ;  2
    jmp .fld_loop                           ;  3
+

    ldx HARD_Y

.crunch_loop
    cpx #0                                  ;  2
    beq +                                   ;  2 (in this loop)

!if SPRITES = 0 {
    +increment_vic_ctrl_y                      ; 16
    +wait_loop 63 - 20 - 2 - 3
} else {
    jsr increment_vic_ctrl_y              ; 22 + 6 (jsr)
    lda VIC_RASTER                          ;  4
    cmp #SPRITES_TOP_Y                      ;  2
    bcs .sprite_rows_crunch_wait            ;  2/3
    +wait_loop 63 - 32 - 4 - 2 - 2 - 2 - 3
}

    dex                                     ;  2
    jmp .crunch_loop                        ;  3
+

!if SPRITES != 0 {
.sprite_rows_fld_loop
    cpx #0                                  ;  2
    beq +                                   ;  2 (in this loop)
    jsr increment_vic_ctrl_y              ; 22 + 6 (jsr)

.sprite_rows_fld_wait
    +wait_loop 44 - 32 - 2 - 3

    dex                                     ;  2
    jmp .sprite_rows_fld_loop               ;  3
+

    ldx HARD_Y

.sprite_rows_crunch_loop
    cpx #0                                  ;  2
    beq +                                   ;  2 (in this loop)
    jsr increment_vic_ctrl_y              ; 22 + 6 (jsr)

.sprite_rows_crunch_wait
    +wait_loop 44 - 32 - 2 - 3

    dex                                     ;  2
    jmp .sprite_rows_crunch_loop            ;  3
+
}
    ; ^^^ these are always 25 raster lines ^^^

;-------------------------------------------------------------------------------
;   VSP
;-------------------------------------------------------------------------------
    ; make VSP line not a bad line
    inc VIC_CTRL_Y                       ;6
!if SPRITES = 0 {
    +wait 5                                 ;5
} else {
    +wait 4                                 ;4
}
    sec                                     ;2
    ; introduce an extra cycle if 39 - HARD_X is odd
.self_modifying_branch__lsb
    +bcs                                    ;2-3

.self_modifying_branch__nops
    ; always true and jump into nop field
    +bcs                                    ;3
    +wait 38                                ;0-38

!if (>IRQ) != (>*) {
    !error "critical irq code in different pages"
}
    ; generate bad line
    dec VIC_CTRL_Y                       ;6

    ; 6 + 4/5 + 2 + 2/3 + 3 + 0/38 + 6 = 23-25/63

;-------------------------------------------------------------------------------
; prepare soft scroll
;-------------------------------------------------------------------------------
    ; reload pre-computed VIC_CTRL_Y value
    pla
    sta VIC_CTRL_Y
    and #CTRL_Y_MASK
    pha

;stx VIC_BORDER    ;4

;-------------------------------------------------------------------------------
; use wait time to setup sprites
;-------------------------------------------------------------------------------

    ; todo

; Which raster line did the AGSP region actually end on?  This is pure slack --
; the wait below polls for a fixed line -- so the stash is free here, and
; last_irq does the comparing where timing is free too.  See "Measuring the AGSP
; band" in CLAUDE.md.
!ifdef AGSP_LIMIT {
    lda VIC_RASTER
    sta AGSP_MARK
}

;-------------------------------------------------------------------------------
; issue soft scroll
;-------------------------------------------------------------------------------

    pla
    ; wait till end of AGSP region
    ldy #SPRITE_MULTIPLEX_START
-
    cpy VIC_RASTER
    bne -

    sta VIC_CTRL_Y

;-------------------------------------------------------------------------------
; sprite multiplexing
;-------------------------------------------------------------------------------

    !ifdef DEBUG {
        ldx #3
        stx VIC_BORDER
;        inc VIC_BORDER
    }

    ; The panel row is finished by now (PANEL_Y + SPRITE_HEIGHT is above the soft
    ; scroll release line), so hand the hardware over to the world sprites:
    ; odd hardware sprites go multicolour again so each pair renders as a
    ; multicolour under a hires overlay.
!if SPRITES != 0 {
    lda #%10101010
    sta VIC_SPRITE_MULTICOLOR
}
    ; walk the display list last_irq scheduled, entry 0 up to SPRITES_SHOWN
    ldx #0

;   sprite with y = 28:
;   27--------------------|... dma disabled
;   28--------------------|... dma enabled
;   29------line 1--------|... dma enabled
;   ..
;   49------line 21-------|... dma disabled
;   50---ready for next---|<-- triggerline = 28+22

rotate_sprite_slots
    !for .i, 0, 3 {
        !set r = 3-.i
        !zone {
.check_done
            cpx SPRITES_SHOWN
            bne .next_sprite
.last_irq
!ifdef DEVELOP {
            ldy VIC_RASTER
            cpy #LAST_IRQ_LINE-2
            bcc +
            jam
+
}
            ldy #LAST_IRQ_LINE
            sty VIC_RASTER
            +set16 last_irq, VECTOR_IRQ
            jmp irq_exit
.next_sprite
            lda VIC_SPRITE_0_Y + r*4 ; get y position of physical sprite
            ; The slot frees SPRITE_HEIGHT+1 lines on; if that is past the last
            ; line we work on there is nothing left to do.  Test *before* the
            ; add: adding to a sprite low on the screen wraps the byte, and the
            ; old code read that overflow as "too high" and abandoned the whole
            ; frame -- which is what stopped sprites reaching the bottom border.
            cmp #SPRITES_MAX_Y-(SPRITE_HEIGHT+1)
            bcs .last_irq       ; nothing left to do
            clc
            adc #SPRITE_HEIGHT+1 ; calculate when sprite will be done, see above diagram

            tay                 ; y = triggerline for next sprite
            sbc VIC_RASTER      ; a = triggerline - rasterline - 1 (omit sec)
            bcc .display_sprite ; rasterline >= triggerline: display next sprite
            cmp #2              ; rasterline < triggerline, a = #lines left - 1
            bcs .set_interrupt  ; at least 3 lines left to set an interrupt
            dey                 ; fewer than 3 lines left, prepare to poll
-
            cpy VIC_RASTER
            bcs -               ; we might be on a badline: use dey, bcs instead of bne
            bcc .display_sprite ; branch always

.set_interrupt
            stx SPRITE_COUNTER
            sty VIC_RASTER
            +set16 .next_irq, VECTOR_IRQ
            jmp irq_exit

.next_irq
            sta restore_registers + 1
            stx restore_registers + 3
            sty restore_registers + 5
;            !ifdef DEBUG {
;                inc VIC_BORDER
;            }
            ldx SPRITE_COUNTER
            !ifdef DEBUG {
                stx VIC_BORDER
            }

.display_sprite
            ldy SPRITE_QUEUE, x
            inx

            ; y-coord
            lda SPRITE_Y, y

            ; Are we too late?  Then skip this one and try the next.  Do NOT
            ; abandon the frame here: the list is sorted, so everything after
            ; this sprite is further down the screen and may well still fit.
            ; Running out of screen is .next_sprite's job -- once a slot we
            ; still need cannot be reused before SPRITES_MAX_Y, no slot can,
            ; because the other three hold sprites that free up even later.
            cmp VIC_RASTER
            bcs .do_display_sprite
!ifdef SPRITE_DROP_LIMIT {
            ; remember the lowest sprite (largest y) we were ever too late for.
            ; -DSPRITE_DROP_LIMIT only: this costs cycles on a path the budget has
            ; no room to spare on, see last_irq.
            cmp SPRITE_DROPPED
            bcc +
            sta SPRITE_DROPPED
+
}
            jmp .check_done

.do_display_sprite
            sta VIC_SPRITE_0_Y + r*4
            sta VIC_SPRITE_0_Y + r*4 + 2

            ; x-coord
            lda SPRITE_X, y
            asl
            sta VIC_SPRITE_0_X + r*4
            sta VIC_SPRITE_0_X + r*4 + 2

            ; x-msb
            bcc .clear_x_msb
.set_x_msb
            lda # %00000011 << 2*r
            ora VIC_SPRITE_X_MSB
            bne +    ; always true
.clear_x_msb
            lda # <!(%00000011 << 2*r)
            and VIC_SPRITE_X_MSB
+
            sta VIC_SPRITE_X_MSB

            ; colors
            lda SPRITE_COLOR_A, y
            sta VIC_SPRITE_0_COLOR + r*2 + 1
            lda SPRITE_COLOR_B, y
            sta VIC_SPRITE_0_COLOR + r*2

            ; sprite frames
            lda SPRITE_FRAME, y
            sta SPRITE_PTR + r*2 + 1
            clc
            adc #1
            sta SPRITE_PTR + r*2

            !if r = 0 {
                jmp rotate_sprite_slots
            }
        }
    }

;-------------------------------------------------------------------------------
; we are finishing the last irq this frame
;-------------------------------------------------------------------------------

last_irq
    sta restore_registers + 1
    stx restore_registers + 3
    sty restore_registers + 5
!ifdef DEBUG {
    lda #10
    sta VIC_BORDER
}
    jsr JOYSTICK
!ifdef DEBUG {
    lda #11
    sta VIC_BORDER
}
    jsr COPY_TILES
!ifdef DEBUG {
    lda #0
    sta VIC_BORDER
}
    jsr PLAY_SONG

;-------------------------------------------------------------------------------
; panel row
;
; Hand the hardware back to the eight single-colour panel sprites for the top of
; the next frame.  They all sit on PANEL_Y, which is what keeps the crunch band's
; 44 cycle path honest -- see the note at SPRITES in engine.acme.  VIC_SPRITE_MULTICOLOR
; goes to hires here and the multiplexer flips it back when it takes over.
;-------------------------------------------------------------------------------

!if SPRITES != 0 {
    lda PANEL_Y
    !for .i, 0, PANEL_SPRITES-1 {
        sta VIC_SPRITE_0_Y + 2*.i
    }
    !for .i, 0, PANEL_SPRITES-1 {
        lda PANEL_X + .i
        sta VIC_SPRITE_0_X + 2*.i
        lda PANEL_COLOR + .i
        sta VIC_SPRITE_0_COLOR + .i
        lda PANEL_FRAME + .i
        sta SPRITE_PTR + .i
    }
    lda PANEL_X_MSB
    sta VIC_SPRITE_X_MSB
    lda #0
    sta VIC_SPRITE_MULTICOLOR
}

;-------------------------------------------------------------------------------
; sort sprites
;-------------------------------------------------------------------------------

    !ifdef DEBUG {
        ldx #2
        stx VIC_BORDER
;        inc VIC_BORDER
    }

    !if SPRITES > 1 {
        !for .i, 0, SPRITES-2 {
            ldy SPRITE_ORDER + .i + 1
            !if .i % 2 = 0 {
                !set .back_0 = *
            } else {
                !set .back_1 = *
            }
            ldx SPRITE_ORDER + .i
            lda SPRITE_Y, y            ; A: r-elem
            cmp SPRITE_Y, x            ; M: l-elem
            ; swap if A < M
            ; skip if A >= M
            bcs +
            stx SPRITE_ORDER + .i + 1
            sty SPRITE_ORDER + .i
            !if .i != 0 {
                !if .i % 2 = 0 {
                    bcc .back_1   ; always true
                } else {
                    bcc .back_0   ; always true
                }
            }
+
        }
    }

;-------------------------------------------------------------------------------
; sprite scheduling
;
; A hardware slot is busy for SPRITE_HEIGHT lines, so a slot can only be reused
; once its previous sprite has finished.  The multiplexer hands sprite n of the
; display list to slot n % SPRITE_SLOTS, which works as long as every sprite is
; at least SPRITE_HEIGHT lines below the one SPRITE_SLOTS places earlier in y
; order.  When sprites cluster that fails, and the old code just dropped
; whichever ones it could not place -- sprites blinking out at random.
;
; Instead, pick the display list here, before the frame is drawn, and thin it
; until it does fit:
;
;   4 zones  every sprite, every frame
;   2 zones  every 2nd sprite in y order, the other half on the next frame
;   1 zone   every 4th sprite in y order, cycling over four frames
;
; Thinning in *y order* rather than by sprite id is what makes this work: it
; halves the density of a cluster instead of leaving its members to collide.
; One zone is always feasible -- SPRITE_SLOTS sprites over SPRITE_SLOTS slots --
; so the chain always terminates and every sprite stays visible, just at a lower
; and, crucially, steady rate.
;-------------------------------------------------------------------------------

!if SPRITES != 0 {
!ifdef AUTOPILOT {
    lda AUTOPILOT_FROZEN
    bne +
}
    inc SPRITE_PHASE
+

    ; SPRITE_Y_SORTED = the sorted y values, contiguous, so the checks below are plain
    ; strided compares instead of another trip through SPRITE_ORDER
    !for .i, 0, SPRITES-1 {
        ldy SPRITE_ORDER + .i
        lda SPRITE_Y, y
        sta SPRITE_Y_SORTED + .i
    }

    ; 4 zones: slot n and slot n+SPRITE_SLOTS must not overlap, over the whole list
    ldx #0
-
    lda SPRITE_Y_SORTED + SPRITE_SLOTS, x
    sec
    sbc SPRITE_Y_SORTED, x
    cmp #SPRITE_HEIGHT+1   ; the multiplexer frees a slot SPRITE_HEIGHT+1 lines on
    bcc .try_two_zones
    inx
    cpx #SPRITES - SPRITE_SLOTS
    bne -
    ; The multiplexer also gives up the moment a slot it still needs holds a
    ; sprite too low to be reused (see .next_sprite), so the last sprite that
    ; still has a successor in its slot has to stay above that line.  Without
    ; this the pair q[i]=SPRITES_MAX_Y-22, q[i+4]=SPRITES_MAX_Y passes the test
    ; above and then gets abandoned mid-frame.
    lda SPRITE_Y_SORTED + SPRITES - SPRITE_SLOTS - 1
    cmp #SPRITES_MAX_Y-(SPRITE_HEIGHT+1)
    bcs .try_two_zones

    ldx #0                          ; stride 1, phase 0
    ldy #SPRITES
    jmp .schedule

.try_two_zones
    ; every 2nd sprite, so the pair that shares a slot is 2*SPRITE_SLOTS apart
    lda SPRITE_PHASE
    and #1
    tax                             ; phase
    ldy #0
-
    lda SPRITE_Y_SORTED + 2*SPRITE_SLOTS, x
    sec
    sbc SPRITE_Y_SORTED, x
    cmp #SPRITE_HEIGHT+1   ; the multiplexer frees a slot SPRITE_HEIGHT+1 lines on
    bcc .one_zone
    inx
    inx
    iny
    cpy #SPRITE_SLOTS
    bne -
    ; same bound as above, for the 8 entry list
    lda SPRITE_PHASE
    and #1
    tax
    lda SPRITE_Y_SORTED + 2*(SPRITES/2 - SPRITE_SLOTS - 1), x
    cmp #SPRITES_MAX_Y-(SPRITE_HEIGHT+1)
    bcs .one_zone

    lda SPRITE_PHASE
    and #1
    tax                             ; stride 2, phase
    ldy #SPRITES / 2
    jmp .schedule

.one_zone
    ; SPRITE_SLOTS sprites over SPRITE_SLOTS slots always fits
    lda SPRITE_PHASE
    and #3
    tax                             ; stride 4, phase
    ldy #SPRITE_SLOTS

.schedule
    ; y = how many to show, x = phase; the stride follows from the count
    sty SPRITES_SHOWN
    cpy #SPRITES
    beq .stride_one
    cpy #SPRITES / 2
    beq .stride_two

    ; stride 4
    ldy #0
-
    lda SPRITE_ORDER, x
    sta SPRITE_QUEUE, y
    inx
    inx
    inx
    inx
    iny
    cpy #SPRITE_SLOTS
    bne -
    jmp .scheduled

.stride_two
    ldy #0
-
    lda SPRITE_ORDER, x
    sta SPRITE_QUEUE, y
    inx
    inx
    iny
    cpy #SPRITES / 2
    bne -
    jmp .scheduled

.stride_one
    !for .i, 0, SPRITES-1 {
        lda SPRITE_ORDER + .i
        sta SPRITE_QUEUE + .i
    }
.scheduled
}

    !ifdef DEBUG {
        ldx #1
        stx VIC_BORDER
;        dec VIC_BORDER
    }

!ifdef DEVELOP {
    lda $d011
    and #$80
    bne +
    lda VIC_RASTER
    bmi +
    cmp #LINE_0-1 ; ok if VIC_RASTER < LINE_0-1
    bcc +
    jam ; if there is too little time, stop execution
+

}

; How far down the screen does the multiplexer still miss sprites?  SPRITE_DROPPED
; holds the largest y it was ever too late for; bisect SPRITE_DROP_LIMIT and the
; lowest limit that does not jam is that y, plus one.  Opt-in rather than part of
; -DDEVELOP because the tracking itself costs enough to blow the budget.
!ifdef SPRITE_DROP_LIMIT {
    lda SPRITE_DROPPED
    cmp #SPRITE_DROP_LIMIT
    bcc +
    jam
+
}

; Same bisect for the line the AGSP region ends on: the lowest limit that does
; not jam is that line, plus one.  It should not vary with HARD_Y -- the region
; is always 25 raster lines -- so a run that scrolls vertically also checks that.
!ifdef AGSP_LIMIT {
    lda AGSP_MARK
    cmp #AGSP_LIMIT
    bcc +
    jam
+
}

    +set_raster_line_8 LINE_0
    +set16 IRQ, VECTOR_IRQ

irq_exit
    !ifdef DEBUG {
        ldx #0
        stx VIC_BORDER
;        dec VIC_BORDER
    }

    inc VIC_IRQ_STATUS

restore_registers
    lda #0
    ldx #0
    ldy #0
    rti

EMPTY_INTERRUPT = *-1
}
