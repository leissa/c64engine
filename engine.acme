!ifdef DEVELOP {
!to "engine.prg", cbm   ; output program
}
!sl "labels.l"          ; acme symbol list; the vice one is the Makefile's --vicelabels
!convtab scr            ; for conversion to c64 screen codes

!source "lib/mem.acme"
!source "lib/vic.acme"
!source "lib/cia.acme"
!source "lib/std.acme"

!ifdef DEBUG {
    CTRL_X         = %00011000 ; 40 cols
    CTRL_Y_INVALID = %00111000 ; 25 rows
} else {
    CTRL_X         = %00010000 ; multi color
    CTRL_Y_INVALID = %01110000 ; invalid mode
}

CTRL_Y_MASK = %10111111 ; bitmap mode

; Every $d011 the engine writes carries CTRL_Y_INVALID's RSEL bit, so that bit
; decides where the vertical border flag switches and hence where the display
; window begins and ends.  See lib/vic.acme.
!if (CTRL_Y_INVALID & VIC_RSEL) != 0 {
VERTICAL_BORDER_TOP = VIC_VERTICAL_BORDER_TOP_25
VERTICAL_BORDER_BOT = VIC_VERTICAL_BORDER_BOT_25
} else {
VERTICAL_BORDER_TOP = VIC_VERTICAL_BORDER_TOP_24
VERTICAL_BORDER_BOT = VIC_VERTICAL_BORDER_BOT_24
}

LINE_0       = FIRST_BADLINE-3
SCROLL_SPEED = 2 ; supported are 1 or 2
TILE_COLS    = 3 ; must divide SCROLL_COLS-1 = 39 exactly (-> 13); asserted in scroll.acme
TILE_ROWS    = 2 ; must divide SCROLL_ROWS-1 = 22 exactly (-> 11); asserted in scroll.acme
SCREEN_COLS  = 40 ; horizontal screen chars in memory. the screen is in 38x24 mode
SCREEN_ROWS  = 25 ; vertical screen chars in memory. the screen is in 38x24 mode

; The map is one Zelda-style area of AREA_COLS x AREA_ROWS tiles, about 2.4 by 2.6
; screens.  It lives at TILE_MAP row major with an AREA_COLS byte stride, so a tile
; is at TILE_MAP + row*AREA_COLS + col and the map cursor is a plain 16 bit offset
; into it.  Several areas, and moving between them, is a later problem; nothing here
; knows about more than this one.
AREA_COLS = 32
AREA_ROWS = 32
; The map in pages, for the wrap_add/wrap_sub masks that keep a cursor inside it.
MAP_PAGES = AREA_COLS*AREA_ROWS/256

; Where the map cursor starts, in tiles into the map.  TILE_COL/TILE_ROW below add
; the sub-tile offset, and init_screen then scrolls left by a screen while filling
; it -- which is what CAMERA_*_INIT records.
MAP_INIT_COL = 27
MAP_INIT_ROW = 2
MAP_INIT     = MAP_INIT_ROW*AREA_COLS + MAP_INIT_COL

; How far the camera may travel before the window would show what is outside the
; area, in pixels.  SCREEN_ROWS rather than the 24 visible rows keeps a row in hand,
; and a further tile is deducted because COPY_TILES works one tile ahead of the
; window: without it the incoming edge shows the tile just outside the area, which
; is visible as a sliver at the trailing edge.  Measured, not derived.
CAMERA_X_MAX = (AREA_COLS*TILE_COLS - SCREEN_COLS - TILE_COLS)*8
CAMERA_Y_MAX = (AREA_ROWS*TILE_ROWS - SCREEN_ROWS - TILE_ROWS)*8

; Where init_screen leaves the camera, in pixels into the map.  It starts at
; MAP_INIT_COL/MAP_INIT_ROW and scrolls left by a screen (8*SCREEN_COLS = 320
; pixels = 13 1/3 tiles), which lands it here.  Not derived from MAP_INIT: the
; sub-tile offsets TILE_COL/TILE_ROW come into it too, so this is measured.
CAMERA_X_INIT = 328
CAMERA_Y_INIT = 32

!if CAMERA_X_INIT > CAMERA_X_MAX {
    !error "CAMERA_X_INIT (", CAMERA_X_INIT, ") starts outside CAMERA_X_MAX (", CAMERA_X_MAX, ")"
}
!if CAMERA_Y_INIT > CAMERA_Y_MAX {
    !error "CAMERA_Y_INIT (", CAMERA_Y_INIT, ") starts outside CAMERA_Y_MAX (", CAMERA_Y_MAX, ")"
}
; The map has to fit in the space lib/mem.acme reserves for it ...
!if AREA_COLS*AREA_ROWS > TILE_COLOR - TILE_MAP {
    !error "the map is ", AREA_COLS*AREA_ROWS, " bytes but only ", TILE_COLOR-TILE_MAP, " are reserved at TILE_MAP"
}
; ... and the wrap_add/wrap_sub masks that confine a cursor to it are single ANDs,
; so its page count has to be a power of two
!if AREA_COLS*AREA_ROWS % 256 != 0 or MAP_PAGES & (MAP_PAGES-1) != 0 {
    !error "the map is ", AREA_COLS*AREA_ROWS, " bytes; it must be a power-of-two number of whole pages"
}
!if MAP_INIT_COL >= AREA_COLS or MAP_INIT_ROW >= AREA_ROWS {
    !error "the initial map cursor (", MAP_INIT_COL, ",", MAP_INIT_ROW, ") is outside the map"
}
; Two disjoint sets share the eight hardware sprites.
;
; PANEL_SPRITES sit on one raster row in the black FLD/crunch band, one hardware
; sprite each, single colour -- meant for hitpoints, weapons, text.  They must
; share a y: the 44 cycle crunch path in raster.acme is 63-19, i.e. all eight
; DMA-active across the whole band.
;
; SPRITES are the world sprites below that, two hardware sprites each (a hires
; over a multicolour one) multiplexed over SPRITE_SLOTS pairs.  SPRITES = 0
; compiles out both sets.
SPRITES       = 16 ; world sprites; must be SPRITE_SLOTS * 4, see SPRITE_ZONES_MAX
PANEL_SPRITES = 8  ; one per hardware sprite, so all of them
SPRITE_SLOTS  = 4  ; hardware sprite pairs available to the multiplexer
SPRITE_HEIGHT = 21 ; raster lines a sprite covers; a slot is busy this long
; Lowering this frees the sprite hardware earlier, and 54 is as low as it can go:
; a sprite at y displays y+1 .. y+21, so below 54 the panel's first line falls
; inside the top border (VERTICAL_BORDER_TOP) and its last line stops short of AGSP_END,
; leaving band lines with no sprites on them that the 44 cycle path in raster.acme
; assumes are full.  Both bounds are asserted below.
;
; It stays at 60 anyway, because freeing the hardware earlier buys nothing on its
; own: what actually gates the world sprites is SPRITE_MULTIPLEX_START, the soft scroll
; release, and that cannot move -- see the note in scroll.acme.
SPRITES_TOP_Y = 60 ; panel row, inside the FLD/crunch band
AGSP_END      = 75 ; last line of the 25 line AGSP region; measured, see CLAUDE.md
SPRITE_FLOOR  = SPRITES_TOP_Y + SPRITE_HEIGHT + 1 ; first line a world sprite can use

; A sprite must still be placeable at the very bottom of the window or it pops
; into view instead of sliding out of the border.  Two separate lines matter:
; SPRITES_MAX_Y is where the multiplexer stops trying to reuse a slot, and
; LAST_IRQ_LINE is where last_irq takes the hardware back for the panel row --
; a sprite whose raster line has not been reached by then never gets latched.
DISPLAY_BOT      = VERTICAL_BORDER_BOT - 1 ; last line before the bottom border
LAST_IRQ_LINE    = 242 ; last_irq takes the hardware back here for the panel row
SPRITES_MAX_Y    = 229 ; multiplexer gives up past this line
; The tileset is per area: tools/mkarea.py cuts colors/screen/pixels.bin to exactly TILES tiles out of the world masters,
; so this is the area's capacity and not how many tiles are drawn (the village uses 95).
; It is also the stride of every plane in those files, and that is the reason for 128 rather than a number that merely fits:
; a tile index reaches TILES-1, so aligning each plane to TILES keeps it inside one page and the copy_tile_char loads
; never pay the abs,x page-crossing cycle.
TILES            = 128

; copy_tile_char reads one byte per plane with abs,x and x is the tile index, so a plane that straddles a page boundary
; costs an extra cycle on every read past the boundary -- ten such reads per char.
; Measured at ~50 cycles a frame on the village's tile mix, and 2 raster lines on the worst frame of a sustained diagonal.
; Every plane base being a multiple of TILES rules it out.
; Check it rather than trust the layout: getting it wrong costs cycles silently, in code whose timing comments still look right.
!set TILE_PLANE_CROSSINGS = 0
!macro check_tile_plane .base {
    !if ((.base) & $ff) + TILES-1 > $ff {
        !set TILE_PLANE_CROSSINGS = TILE_PLANE_CROSSINGS + 1
    }
}
!for .char, 0, TILE_COLS*TILE_ROWS-1 {
    +check_tile_plane TILE_COLOR  + .char*TILES
    +check_tile_plane TILE_SCREEN + .char*TILES
    !for .row, 0, 7 {
        +check_tile_plane TILE_PIXELS + (.char*8 + .row)*TILES
    }
}
!if TILE_PLANE_CROSSINGS != 0 {
    !error TILE_PLANE_CROSSINGS, " of the ", TILE_COLS*TILE_ROWS*10, " tileset planes cross a page boundary; TILES (", TILES, ") must be a power of two and TILE_COLOR/TILE_SCREEN/TILE_PIXELS multiples of it"
}
; must split SCROLL_ROWS/SCROLL_COLS exactly and fit in the 4/SCROLL_SPEED frames
; a soft scroll leaves before the hard step; both asserted in tiles.acme
; The multiplexer degrades in powers of two: SPRITE_ZONES_MAX sprites per slot when
; nothing clusters, then half of them on alternate frames, then a quarter on
; every fourth frame.  See "sprite scheduling" in raster.acme.
SPRITE_ZONES_MAX = SPRITES / SPRITE_SLOTS

; The SCREEN_ROWS rows of screen matrix have to end exactly where the border comes
; on, or the bottom row is either cut off or scrolled in under the border.  That
; the two agree is a coincidence of FIRST_BADLINE and SCREEN_ROWS and not a
; derivation, so say so out loud.  The debug build runs RSEL set and a taller
; window, and does not have to line up.
!if (CTRL_Y_INVALID & VIC_RSEL) = 0 {
  !if DISPLAY_BOT != FIRST_BADLINE + 8*SCREEN_ROWS - 2 {
    !error "the ", SCREEN_ROWS, " rows from FIRST_BADLINE (", FIRST_BADLINE, ") end at ", FIRST_BADLINE + 8*SCREEN_ROWS - 2, ", but the bottom border starts at ", VERTICAL_BORDER_BOT
  }
}

!if SPRITES != 0 {
  ; a sprite at y displays y+1 .. y+21, so it is the *first displayed* line that
  ; has to clear the border, not y itself
  !if SPRITES_TOP_Y + 1 < VERTICAL_BORDER_TOP {
    !error "SPRITES_TOP_Y (", SPRITES_TOP_Y, ") puts the panel's first line above the first visible line (", VERTICAL_BORDER_TOP, ")"
  }
  ; A world sprite going DMA-active inside the band would make the per-line steal
  ; vary and mistime the whole AGSP, so the floor has to sit below the band ...
  !if SPRITE_FLOOR <= AGSP_END {
    !error "SPRITE_FLOOR (", SPRITE_FLOOR, ") is inside the AGSP band, which ends at ", AGSP_END
  }
  ; ... and the panel has to stay DMA-active all the way to the band's last line
  !if SPRITES_TOP_Y + SPRITE_HEIGHT < AGSP_END {
    !error "the panel row ends at ", SPRITES_TOP_Y + SPRITE_HEIGHT, ", above the band's last line ", AGSP_END
  }
  !if SPRITES % SPRITE_SLOTS != 0 {
    !error "SPRITES (", SPRITES, ") must be a multiple of SPRITE_SLOTS (", SPRITE_SLOTS, ")"
  }
  !if SPRITE_ZONES_MAX != 4 {
    !error "SPRITE_ZONES_MAX is ", SPRITE_ZONES_MAX, "; the 4/2/1 fallback chain assumes 4"
  }
  !if PANEL_SPRITES != 2 * SPRITE_SLOTS {
    !error "PANEL_SPRITES (", PANEL_SPRITES, ") must cover all ", 2*SPRITE_SLOTS, " hardware sprites"
  }
}

COPY_ROW_FRAMES = 2 ; use 2 frames to copy all rows, vertically
!if SCROLL_SPEED = 2 {
COPY_COL_FRAMES = 2 ; use 2 frames to copy all cols, horizontally
} else {
COPY_COL_FRAMES = 4 ; use 4 frames to copy all cols, horizontally
}

*=SPRITE_DATA

; ---- world sprites, SPRITES entries each -------------------------------------
; sprite_y_init seeds SPRITE_Y in zero page; the rest are read in place.
; SPRITE_X is half resolution -- the multiplexer does an asl and takes the msb from
; the carry -- so one unit is two pixels.
sprite_y_init
    !by $64, $6c, $74, $7c, $88, $90, $98, $a0, $a8, $b0, $b8, $c0, $c8, $d0, $d8, $e0
SPRITE_X
    !by $50, $60, $70, $80, $10, $20, $30, $40, $50, $60, $70, $80, $10, $20, $30, $40
SPRITE_COLOR_A
    !by $04, $05, $06, $07, $08, $09, $0a, $0a, $0a, $0d, $0e, $0f, $00, $01, $02, $03
SPRITE_COLOR_B
    !by $0b, $0a, $09, $08, $07, $06, $05, $00, $00, $02, $01, $00, $0f, $0e, $0d, $0c
SPRITE_FRAME
    !by SPRITE_FRAMES_BASE+$08, SPRITE_FRAMES_BASE+$0a, SPRITE_FRAMES_BASE+$0c, SPRITE_FRAMES_BASE+$0e
    !by SPRITE_FRAMES_BASE+$10, SPRITE_FRAMES_BASE+$12, SPRITE_FRAMES_BASE+$14, SPRITE_FRAMES_BASE+$00
    !by SPRITE_FRAMES_BASE+$02, SPRITE_FRAMES_BASE+$1a, SPRITE_FRAMES_BASE+$1c, SPRITE_FRAMES_BASE+$1e
    !by SPRITE_FRAMES_BASE+$04, SPRITE_FRAMES_BASE+$04, SPRITE_FRAMES_BASE+$04, SPRITE_FRAMES_BASE+$06

; ---- panel row, PANEL_SPRITES entries each -----------------------------------
; One hardware sprite each, all on PANEL_Y, so they are written straight out by
; last_irq and never take part in the sort or the multiplexer.  X is full 9 bit
; here (PANEL_X plus one bit per sprite in PANEL_X_MSB) because these are placed by
; hand, not scrolled.
PANEL_Y
    !by SPRITES_TOP_Y
PANEL_X
    !by 24, 48, 72, 96, 180, 204, 228, 252
PANEL_X_MSB
    !by %00000000
PANEL_COLOR
    !by $02, $02, $02, $07, $01, $01, $0d, $0d
PANEL_FRAME
    !by SPRITE_FRAMES_BASE+$00, SPRITE_FRAMES_BASE+$00, SPRITE_FRAMES_BASE+$00, SPRITE_FRAMES_BASE+$02
    !by SPRITE_FRAMES_BASE+$04, SPRITE_FRAMES_BASE+$04, SPRITE_FRAMES_BASE+$06, SPRITE_FRAMES_BASE+$06

+create_basic_starter CODE_START
*=CODE_START

!zone {
; Entered either from the BASIC starter above (DEVELOP builds) or by a jmp from the EasyFlash boot copier, which has
; already placed all data in RAM and switched the cartridge off -- see easyflash.acme.

;-------------------------------------------------------------------------------
;   disable all basic, kernal and irq crap
;-------------------------------------------------------------------------------

    ; set empty interrupt routine
    +set16 EMPTY_INTERRUPT, VECTOR_NMI
    +set16 EMPTY_INTERRUPT, VECTOR_IRQ

    ; disable IRQs
    sei

    ; disable ROMs
    +set ALL_RAM_WITH_IO, RAM_ROM_SELECTION
    +disable_timer_interrupts

    lda #0
    ; no IRQs
    sta VIC_IRQ_CTRL
    ; set timer A to 0
    sta CIA2_TIMER_A_LO
    sta CIA2_TIMER_A_HI

    ; trigger timer A interrupt
    +set %10000001, CIA2_INTERRUPT_CTRL
    +set %00000001, CIA2_TIMER_A_CTRL

    ; reset stack
    ldx #$ff
    txs

    ; just clear this flag and never ever touch this again
    cld

    ; -> NMI is disabled as soon as EMPTY_INTERRUPT has been triggered since we will never ever ack NMI again
    ; -> zero page completely free on this spot except for the special regs $00 and $01

;-------------------------------------------------------------------------------
;   setup VIC
;-------------------------------------------------------------------------------

    ; select VIC area: bank 3
    lda #0; upper 6 bits must always be 0
    sta CIA2_DATA_PORT_A

    ; select screen bank 8, hires-bank 0
    lda #%10000000
    sta VIC_ADDRESS_SELECT

    +set %10101010, VIC_SPRITE_MULTICOLOR
    +set BROWN, VIC_SPRITE_MULTICOLOR_01
    +set GREY,  VIC_SPRITE_MULTICOLOR_11
    +set $ff, VIC_SPRITE_ENABLE

;-------------------------------------------------------------------------------
;   setup test stuff
;-------------------------------------------------------------------------------

    !if SPRITES > 0 {
        ; sprite_y_init is already in ascending order, so SPRITE_ORDER starts out sorted
        !for .i, 0, SPRITES-1 {
            lda sprite_y_init + .i
            sta SPRITE_Y + .i
            lda #.i
            sta SPRITE_ORDER + .i
        }
        lda #0
        sta SPRITE_PHASE
!ifdef AUTOPILOT {
        sta AUTOPILOT_FROZEN
}
        ; until the first last_irq has scheduled a frame, show nothing
        sta SPRITES_SHOWN
        ldx #$ff
    } else {
        ldx #0
    }
    stx VIC_SPRITE_ENABLE

    ;---can be done at compile time?---
    ldx #CTRL_Y_INVALID
    stx CTRL_Y_INVALID_COPY

    ldx #0
    stx COL_COPY
    stx ROW_COPY
    stx SCROLL_LAST_VERTICAL
    stx SCROLL_LAST_HORIZONTAL

    ldx #BLACK
    stx VIC_BACKGROUND_0
    stx VIC_BORDER

    ldx #2
    stx TILE_COL
    ldx #1
    stx TILE_ROW

    ; both cursors are 16 bit offsets into the map; init_ptrs adds TILE_MAP
    ldx #<MAP_INIT
    stx COL_MAP_POS_LO
    stx ROW_MAP_POS_LO
    ldx #>MAP_INIT
    stx COL_MAP_POS_HI
    stx ROW_MAP_POS_HI

    ldx #0
    stx COL_SCREEN_POS_LO
    stx COL_SCREEN_POS_HI
    stx ROW_SCREEN_POS_LO
    stx ROW_SCREEN_POS_HI
    stx COL_PIXEL_POS_LO
    stx COL_PIXEL_POS_HI
    stx ROW_PIXEL_POS_LO
    stx ROW_PIXEL_POS_HI
    ;----------------------------------

;-------------------------------------------------------------------------------
;   setup sound
;-------------------------------------------------------------------------------

    lda #0       ; starting from 0
    jsr INIT_SONG

;-------------------------------------------------------------------------------
;   initialize screen
;
;   Tile data is already in place:
;   it is linked in below and, for the cartridge, copied from the EasyFlash banks into RAM before we were entered.
;-------------------------------------------------------------------------------

    jsr init_screen

    ; init_screen is what establishes where the camera ends up: it scrolls left by
    ; a full screen while filling it, so the window lands CAMERA_*_INIT into the area.
    ; Measured by walking to each bound and checking the area's edge is reached
    ; exactly -- see "Camera bounds" in CLAUDE.md.
    +set16 CAMERA_X_INIT, CAMERA_X_LO
    +set16 CAMERA_Y_INIT, CAMERA_Y_LO

;-------------------------------------------------------------------------------
;   setup raster irq
;-------------------------------------------------------------------------------

    ; ack all interrupts which might have happend
    +set $ff, VIC_IRQ_STATUS

    +set16 IRQ, VECTOR_IRQ
    +set_raster_line_9 LINE_0
    +set 1, VIC_IRQ_CTRL
    ; enable IRQs
    cli
-
    ; some 7 cycle garbage instructions
    lda ($f0), y
    lda ($f0, x)
    lda ($f0), y
    lda ($f0, x)
    lda ($f0), y
    sec     ; 2
    +bcs    ; 3
    jmp -
}

!source "scroll.acme"
!source "joystick.acme"
!source "raster.acme"
!source "tiles.acme"

init_screen !zone {
    lda #(8*SCREEN_COLS/SCROLL_SPEED % 256)
    sta INIT_SCREEN_LO
    lda #1+(8*SCREEN_COLS/SCROLL_SPEED / 256)
    sta INIT_SCREEN_HI
-
    jsr SCROLL_L
    jsr COPY_TILES
    dec INIT_SCREEN_LO
    bne -
    lda #$ff
    sta INIT_SCREEN_LO
    dec INIT_SCREEN_HI
    bne -

    rts
}

!ifdef DEBUG {
    !warn "code ends on: ", *-1
}

; ACME only *warns* when the next segment starts inside this one, and the next
; segment is SONG_DATA -- so overflowing here silently gets the tail of the code
; overwritten by the song binary, which shows up as a dead engine rather than as
; a build failure.  Make it a build failure.
!if * > SONG_DATA {
    !error "code segment ends at ", *-1, " and overruns SONG_DATA at ", SONG_DATA, " by ", *-SONG_DATA, " bytes"
}

*=SONG_DATA
!bin "snd/transylvanian.bin"

*=TILE_MAP
!bin "map.bin"
; map.bin is the map, so its size is not a free parameter: a file of the wrong shape
; assembles happily and then scrolls garbage, which is slow to diagnose.
!if * - TILE_MAP != AREA_COLS*AREA_ROWS {
    !error "map.bin is ", *-TILE_MAP, " bytes; AREA_COLS*AREA_ROWS is ", AREA_COLS*AREA_ROWS, " -- rerun tools/mkarea.py"
}

; The tileset, one plane of TILES bytes per char and -- for the pixels -- per char and pixel row.
; Like map.bin these are generated, so their size is not a free parameter:
; a plane set cut at the wrong stride assembles happily and then draws garbage.
*=TILE_COLOR
!bin "colors.bin"
!if * - TILE_COLOR != TILE_COLS*TILE_ROWS*TILES {
    !error "colors.bin is ", *-TILE_COLOR, " bytes; TILE_COLS*TILE_ROWS*TILES is ", TILE_COLS*TILE_ROWS*TILES, " -- rerun tools/mkarea.py"
}

*=TILE_SCREEN
!bin "screen.bin"
!if * - TILE_SCREEN != TILE_COLS*TILE_ROWS*TILES {
    !error "screen.bin is ", *-TILE_SCREEN, " bytes; TILE_COLS*TILE_ROWS*TILES is ", TILE_COLS*TILE_ROWS*TILES, " -- rerun tools/mkarea.py"
}

*=TILE_PIXELS
!bin "pixels.bin"
!if * - TILE_PIXELS != TILE_COLS*TILE_ROWS*8*TILES {
    !error "pixels.bin is ", *-TILE_PIXELS, " bytes; TILE_COLS*TILE_ROWS*8*TILES is ", TILE_COLS*TILE_ROWS*8*TILES, " -- rerun tools/mkarea.py"
}

*=SPRITE_FRAMES
!bin "spr/hero.raw", 64*4

!for .i, 0, 15 {
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    ;+sprite_line %.............#.#.#.#.#.#
    !by .i, .i, .i
    !by .i, .i, .i
    !by .i, .i, .i
    ;+sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    !by $00; padding
    +sprite_line %########################
    +sprite_line %#.#..................#.#
    +sprite_line %#..#................#..#
    +sprite_line %#...#..............#...#
    +sprite_line %#....#............#....#
    +sprite_line %#.....#..........#.....#
    +sprite_line %#......#........#......#
    +sprite_line %#.......#......#.......#
    +sprite_line %#........#....#........#
    +sprite_line %#.........#..#.........#
    +sprite_line %#..........##..........#
    +sprite_line %#.........#..#.........#
    +sprite_line %#........#....#........#
    +sprite_line %#.......#......#.......#
    +sprite_line %#......#........#......#
    +sprite_line %#.....#..........#.....#
    +sprite_line %#....#............#....#
    +sprite_line %#...#..............#...#
    +sprite_line %#..#................#..#
    +sprite_line %#.#..................#.#
    +sprite_line %########################
    !by $00; padding
}

!ifdef DEBUG {
    !warn "frames end on: ", *-1
}
