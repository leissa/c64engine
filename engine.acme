!ifdef DEVELOP {
!to "engine.prg", cbm   ; output program
}
!sl "labels.l"          ; create label file for vice
!convtab scr            ; for conversion to c64 screen codes

!source "lib/mem.acme"
!source "lib/vic.acme"
!source "lib/cia.acme"
!source "lib/std.acme"

!ifdef DEBUG {
    CONTROL_X           = %00011000 ; 40 cols
    CONTROL_Y_INVALID   = %00111000 ; 25 rows
} else {
    CONTROL_X           = %00010000 ; multi color
    CONTROL_Y_INVALID   = %01110000 ; invalid mode
}

CONTROL_Y_MASK      = %10111111 ; bitmap mode
LINE_0              = FIRST_BADLINE-3
SCROLL_SPEED        = 1 ; supported are 1 or 2
TILE_COLS           = 3 ; must divide SCROLL_COLS-1 = 39 exactly (-> 13); asserted in scroll.acme
TILE_ROWS           = 2 ; must divide SCROLL_ROWS-1 = 22 exactly (-> 11); asserted in scroll.acme
SCR_COLS            = 40 ; horizontal screen chars in memory. the screen is in 38x24 mode
SCR_ROWS            = 25 ; vertical screen chars in memory. the screen is in 38x24 mode
MAP_WIDTH           = 256 ; assumed by the code, no other widths supported atm
MAP_HEIGHT          = 96 ; not really used in the code, but good to know nonetheless
; Two disjoint sets share the eight hardware sprites.
;
; PANEL_SPRITES sit on one raster row in the black FLD/crunch band, one hardware
; sprite each, single colour -- meant for hitpoints, weapons, text.  They must
; share a y: the 44 cycle crunch path in raster.acme is 63-19, i.e. all eight
; DMA-active across the whole band.
;
; SPRITES are the world sprites below that, two hardware sprites each (a hires
; over a multicolour one) multiplexed over SPRITE_SLOTS pairs.  SPRITES = 0
; compiles out both sets.
SPRITES             = 16 ; world sprites; must be SPRITE_SLOTS * 4, see SPR_ZONES_MAX
PANEL_SPRITES       = 8  ; one per hardware sprite, so all of them
SPRITE_SLOTS        = 4  ; hardware sprite pairs available to the multiplexer
SPRITE_HEIGHT       = 21 ; raster lines a sprite covers; a slot is busy this long
SPRITES_TOP_Y       = 60 ; the panel row, in the fld/crunch area, between 55 and 60
SPRITES_MAX_Y       = 229 ; the lower, the more off-screen raster time we have to do other things
TILES               = 185 ; TODO: calculate this with pixels.bin size / 8 / TILE_COLS / TILE_ROWS
; must split SCROLL_ROWS/SCROLL_COLS exactly and fit in the 4/SCROLL_SPEED frames
; a soft scroll leaves before the hard step; both asserted in tiles.acme
; The multiplexer degrades in powers of two: SPR_ZONES_MAX sprites per slot when
; nothing clusters, then half of them on alternate frames, then a quarter on
; every fourth frame.  See "sprite scheduling" in raster.acme.
SPR_ZONES_MAX       = SPRITES / SPRITE_SLOTS

!if SPRITES != 0 {
  !if SPRITES % SPRITE_SLOTS != 0 {
    !error "SPRITES (", SPRITES, ") must be a multiple of SPRITE_SLOTS (", SPRITE_SLOTS, ")"
  }
  !if SPR_ZONES_MAX != 4 {
    !error "SPR_ZONES_MAX is ", SPR_ZONES_MAX, "; the 4/2/1 fallback chain assumes 4"
  }
  !if PANEL_SPRITES != 2 * SPRITE_SLOTS {
    !error "PANEL_SPRITES (", PANEL_SPRITES, ") must cover all ", 2*SPRITE_SLOTS, " hardware sprites"
  }
}

COPY_ROW_FRAMES     = 2 ; use 2 frames to copy all rows, vertically
!if SCROLL_SPEED = 2 {
COPY_COL_FRAMES     = 2 ; use 2 frames to copy all cols, horizontally
} else {
COPY_COL_FRAMES     = 4 ; use 4 frames to copy all cols, horizontally
}

*=SPR_DATA

; ---- world sprites, SPRITES entries each -------------------------------------
; _spr_y seeds SPR_Y in zero page; the rest are read in place.
; SPR_X is half resolution -- the multiplexer does an asl and takes the msb from
; the carry -- so one unit is two pixels.
_spr_y
    !by $64, $6c, $74, $7c, $88, $90, $98, $a0, $a8, $b0, $b8, $c0, $c8, $d0, $d8, $e0
SPR_X
    !by $50, $60, $70, $80, $10, $20, $30, $40, $50, $60, $70, $80, $10, $20, $30, $40
SPR_A
    !by $04, $05, $06, $07, $08, $09, $0a, $0a, $0a, $0d, $0e, $0f, $00, $01, $02, $03
SPR_B
    !by $0b, $0a, $09, $08, $07, $06, $05, $00, $00, $02, $01, $00, $0f, $0e, $0d, $0c
SPR_F
    !by SPR_FR_BASE+$08, SPR_FR_BASE+$0a, SPR_FR_BASE+$0c, SPR_FR_BASE+$0e
    !by SPR_FR_BASE+$10, SPR_FR_BASE+$12, SPR_FR_BASE+$14, SPR_FR_BASE+$00
    !by SPR_FR_BASE+$02, SPR_FR_BASE+$1a, SPR_FR_BASE+$1c, SPR_FR_BASE+$1e
    !by SPR_FR_BASE+$04, SPR_FR_BASE+$04, SPR_FR_BASE+$04, SPR_FR_BASE+$06

; ---- panel row, PANEL_SPRITES entries each -----------------------------------
; One hardware sprite each, all on PANEL_Y, so they are written straight out by
; last_irq and never take part in the sort or the multiplexer.  X is full 9 bit
; here (PANEL_X plus one bit per sprite in PANEL_X_MSB) because these are placed by
; hand, not scrolled.
PANEL_Y
    !by SPRITES_TOP_Y
PANEL_X
    !by 24, 48, 72, 96, 180, 204, 228, 252
PANEL_X_MSB
    !by %00000000
PANEL_C
    !by $02, $02, $02, $07, $01, $01, $0d, $0d
PANEL_F
    !by SPR_FR_BASE+$00, SPR_FR_BASE+$00, SPR_FR_BASE+$00, SPR_FR_BASE+$02
    !by SPR_FR_BASE+$04, SPR_FR_BASE+$04, SPR_FR_BASE+$06, SPR_FR_BASE+$06

+create_basic_starter CODE_START
*=CODE_START

!zone {
; Entered either from the BASIC starter above (DEVELOP builds) or by a jmp from the EasyFlash boot copier, which has
; already placed all data in RAM and switched the cartridge off -- see easyflash.acme.

;-------------------------------------------------------------------------------
;   disable all basic, kernal and irq crap
;-------------------------------------------------------------------------------

    ; set empty interrupt routine
    +set16 EMPTY_INTERRUPT, VECTOR_NMI
    +set16 EMPTY_INTERRUPT, VECTOR_IRQ

    ; disable IRQs
    sei

    ; disable ROMs
    +set ALL_RAM_WITH_IO, RAM_ROM_SELECTION
    +disable_timer_interrupts

    lda #0
    ; no IRQs
    sta VIC_IRQ_CONTROL
    ; set timer A to 0
    sta CIA2_TIMER_A_LO
    sta CIA2_TIMER_A_HI

    ; trigger timer A interrupt
    +set %10000001, CIA2_INTERRUPT_CONTROL
    +set %00000001, CIA2_CONTROL_TIMER_A

    ; reset stack
    ldx #$ff
    txs

    ; just clear this flag and never ever touch this again
    cld

    ; -> NMI is disabled as soon as EMPTY_INTERRUPT has been triggered since we will never ever ack NMI again
    ; -> zero page completely free on this spot except for the special regs $00 and $01

;-------------------------------------------------------------------------------
;   setup VIC
;-------------------------------------------------------------------------------

    ; select VIC area: bank 3
    lda #0; upper 6 bits must always be 0
    sta CIA2_DATA_PORT_A

    ; select screen bank 8, hires-bank 0
    lda #%10000000
    sta VIC_ADDR_SELECT

    +set %10101010, VIC_SPR_MULTI
    +set BROWN, VIC_SPR_COLOR_01
    +set GREY,  VIC_SPR_COLOR_11
    +set $ff, VIC_SPR_ENABLE

;-------------------------------------------------------------------------------
;   setup test stuff
;-------------------------------------------------------------------------------

    !if SPRITES > 0 {
        ; _spr_y is already in ascending order, so SPR_I starts out sorted
        !for .i, 0, SPRITES-1 {
            lda _spr_y + .i
            sta SPR_Y + .i
            lda #.i
            sta SPR_I + .i
        }
        lda #0
        sta SPR_FRAME
!ifdef AUTOPILOT {
        sta AP_FROZEN
}
        ; until the first last_irq has scheduled a frame, show nothing
        sta SPR_SHOWN
        ldx #$ff
    } else {
        ldx #0
    }
    stx VIC_SPR_ENABLE

    ;---can be done at compile time?---
    ldx #CONTROL_Y_INVALID
    stx CTRL_Y_INVALID

    ldx #0
    stx C_COPY
    stx R_COPY
    stx SCROLL_U_D
    stx SCROLL_L_R

    ldx #COLOR_BLACK
    stx VIC_BACKGROUND_0
    stx VIC_BORDER

    ldx #2
    stx TILE_COL
    ldx #1
    stx TILE_ROW

;    ldx #<TILE_MAP
;    ldx #$80
    ldx #$7b
    stx C_MAP_POS_LO
    stx R_MAP_POS_LO
;    ldx #>TILE_MAP
;    ldx #$40
    ldx #$22
    stx C_MAP_POS_HI
    stx R_MAP_POS_HI

    ldx #0
    stx C_SCR_POS_LO
    stx C_SCR_POS_HI
    stx R_SCR_POS_LO
    stx R_SCR_POS_HI
    stx C_PIX_POS_LO
    stx C_PIX_POS_HI
    stx R_PIX_POS_LO
    stx R_PIX_POS_HI
    ;----------------------------------

;-------------------------------------------------------------------------------
;   setup sound
;-------------------------------------------------------------------------------

    lda #0       ; starting from 0
    jsr INIT_SONG

;-------------------------------------------------------------------------------
;   initialize screen
;
;   Tile data is already in place:
;   it is linked in below and, for the cartridge, copied from the EasyFlash banks into RAM before we were entered.
;-------------------------------------------------------------------------------

    jsr init_screen

;-------------------------------------------------------------------------------
;   setup raster irq
;-------------------------------------------------------------------------------

    ; ack all interrupts which might have happend
    +set $ff, VIC_IRQ_STATUS

    +set16 IRQ, VECTOR_IRQ
    +set_raster_line_9 LINE_0
    +set 1, VIC_IRQ_CONTROL
    ; enable IRQs
    cli
-
    ; some 7 cycle garbage instructions
    lda ($f0), y
    lda ($f0, x)
    lda ($f0), y
    lda ($f0, x)
    lda ($f0), y
    sec     ; 2
    +bcs    ; 3
    jmp -
}

!source "scroll.acme"
!source "joystick.acme"
!source "raster.acme"
!source "tiles.acme"

init_screen !zone {
    lda #(8*SCR_COLS/SCROLL_SPEED % 256)
    sta INIT_SCREEN_LO
    lda #1+(8*SCR_COLS/SCROLL_SPEED / 256)
    sta INIT_SCREEN_HI
-
    jsr SCROLL_L
    jsr COPY_TILES
    dec INIT_SCREEN_LO
    bne -
    lda #$ff
    sta INIT_SCREEN_LO
    dec INIT_SCREEN_HI
    bne -

    rts
}

!ifdef DEBUG {
    !warn "code ends on: ", *-1
}

; ACME only *warns* when the next segment starts inside this one, and the next
; segment is SONG_DATA -- so overflowing here silently gets the tail of the code
; overwritten by the song binary, which shows up as a dead engine rather than as
; a build failure.  Make it a build failure.
!if * > SONG_DATA {
    !error "code segment ends at ", *-1, " and overruns SONG_DATA at ", SONG_DATA, " by ", *-SONG_DATA, " bytes"
}

*=SONG_DATA
!bin "snd/transylvanian.bin"

*=TILE_MAP
!bin "map.bin"

*=TILE_CLR
!bin "colors.bin"

*=TILE_SCR
!bin "screen.bin"

*=TILE_PIX
!bin "pixels.bin"

*=SPR_FR
!bin "spr/hero.raw", 64*4

!for .i, 0, 15 {
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    +sprite_line %.............#.#.#.#.#.#
    ;+sprite_line %.............#.#.#.#.#.#
    !by .i, .i, .i
    !by .i, .i, .i
    !by .i, .i, .i
    ;+sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    +sprite_line %#.#.#.#.#.#.############
    !by $00; padding
    +sprite_line %########################
    +sprite_line %#.#..................#.#
    +sprite_line %#..#................#..#
    +sprite_line %#...#..............#...#
    +sprite_line %#....#............#....#
    +sprite_line %#.....#..........#.....#
    +sprite_line %#......#........#......#
    +sprite_line %#.......#......#.......#
    +sprite_line %#........#....#........#
    +sprite_line %#.........#..#.........#
    +sprite_line %#..........##..........#
    +sprite_line %#.........#..#.........#
    +sprite_line %#........#....#........#
    +sprite_line %#.......#......#.......#
    +sprite_line %#......#........#......#
    +sprite_line %#.....#..........#.....#
    +sprite_line %#....#............#....#
    +sprite_line %#...#..............#...#
    +sprite_line %#..#................#..#
    +sprite_line %#.#..................#.#
    +sprite_line %########################
    !by $00; padding
}

!ifdef DEBUG {
    !warn "frames end on: ", *-1
}
