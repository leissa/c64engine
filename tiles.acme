!macro copy_tile_char .char {
    ldy #0
    lda TILE_COLOR+(.char*TILES), x
    sta (COLOR_POS_LO_TMP), y

    lda TILE_SCREEN+(.char*TILES), x
    sta (SCREEN_POS_LO_TMP), y

    lda #ALL_RAM
    sta RAM_ROM_SELECTION

    !for .row, 0, 7 {
        lda TILE_PIXELS+(.char*8*TILES)+(.row*TILES), x
        sta (PIXEL_POS_LO_TMP), y
        !if .row != 7 {
            iny
        }
    }

    lda #ALL_RAM_WITH_IO
    sta RAM_ROM_SELECTION

    rts
}

copy_tile_char0 !zone { +copy_tile_char 0 }
copy_tile_char1 !zone { +copy_tile_char 1 }
copy_tile_char2 !zone { +copy_tile_char 2 }
copy_tile_char3 !zone { +copy_tile_char 3 }
copy_tile_char4 !zone { +copy_tile_char 4 }
copy_tile_char5 !zone { +copy_tile_char 5 }

; Every copy_tile_charN comes out of the same macro, so they are all the same
; length and the routine for char N can be addressed arithmetically.  That is
; what lets the unrolled loop below call one directly instead of running a char
; index down a cmp/bne chain.
TILE_CHARS          = TILE_COLS * TILE_ROWS
COPY_TILE_CHAR_SIZE = copy_tile_char1 - copy_tile_char0

!if TILE_CHARS != 6 {
    !error "TILE_COLS*TILE_ROWS = ", TILE_CHARS, " but only copy_tile_char0..5 are defined"
}

!if copy_tile_char5 - copy_tile_char0 != 5 * COPY_TILE_CHAR_SIZE {
    !error "copy_tile_charN routines are not uniformly sized"
}

!macro jsr_copy_tile_char .char {
    jsr copy_tile_char0 + .char * COPY_TILE_CHAR_SIZE
}

!macro iterate_dst_ptrs .stride {
    ; pixel pointer
    lda PIXEL_POS_LO_TMP
    adc #(8*.stride % 256) ; + 64
    sta PIXEL_POS_LO_TMP
!if .stride = 1 {
    bcc+
}
    lda PIXEL_POS_HI_TMP
    adc #(8*.stride / 256) ; + 256
    and #%11011111 ; modulo 8192 (but keep upper bits)
    sta PIXEL_POS_HI_TMP ; next pixel position to start from
+
    ; color pointers
    lda SCREEN_POS_LO_TMP
    adc #.stride
    sta SCREEN_POS_LO_TMP ; next screen position to start from
    sta COLOR_POS_LO_TMP
    bcc +

    lda COLOR_POS_HI_TMP
    adc #0
    and #%11111011 ; modulo 1024 (but keep upper bits)
    sta COLOR_POS_HI_TMP

    adc #%00001000
    sta SCREEN_POS_HI_TMP
+
}

; depends on TILE_COLS and TILE_ROWS
;select_and_copy_tile_char !zone {
;    !for .char, 0, 5 {
;        !if .char != 5 {
;            !if .char != 0 {
;                cmp #.char
;            }
;            bne +
;        }
;        !if .char = 0 { jsr copy_tile_char0 }
;        !if .char = 1 { jsr copy_tile_char1 }
;        !if .char = 2 { jsr copy_tile_char2 }
;        !if .char = 3 { jsr copy_tile_char3 }
;        !if .char = 4 { jsr copy_tile_char4 }
;        !if .char = 5 { jsr copy_tile_char5 }
;        rts
;+
;    }
;}

!macro init_ptrs .stride {
!if .stride = 1 {
    !set .tile_col = COL_TILE_COL
    !set .tile_row = COL_TILE_ROW
    !set .map_pos_lo = COL_MAP_POS_LO
    !set .map_pos_hi = COL_MAP_POS_HI
    !set .pixel_pos_lo = COL_PIXEL_POS_LO
    !set .pixel_pos_hi = COL_PIXEL_POS_HI
    !set .screen_pos_lo = COL_SCREEN_POS_LO
    !set .screen_pos_hi = COL_SCREEN_POS_HI
    !set .map_pos_lo_tmp = COL_MAP_POS_LO_TMP
    !set .map_pos_hi_tmp = COL_MAP_POS_HI_TMP
    !set .pixel_pos_lo_tmp = COL_PIXEL_POS_LO_TMP
    !set .pixel_pos_hi_tmp = COL_PIXEL_POS_HI_TMP
    !set .screen_pos_lo_tmp = COL_SCREEN_POS_LO_TMP
    !set .screen_pos_hi_tmp = COL_SCREEN_POS_HI_TMP
    !set .color_pos_hi_tmp = COL_COLOR_POS_HI_TMP
} else {
    !set .tile_col = ROW_TILE_COL
    !set .tile_row = ROW_TILE_ROW
    !set .map_pos_lo = ROW_MAP_POS_LO
    !set .map_pos_hi = ROW_MAP_POS_HI
    !set .pixel_pos_lo = ROW_PIXEL_POS_LO
    !set .pixel_pos_hi = ROW_PIXEL_POS_HI
    !set .screen_pos_lo = ROW_SCREEN_POS_LO
    !set .screen_pos_hi = ROW_SCREEN_POS_HI
    !set .map_pos_lo_tmp = ROW_MAP_POS_LO_TMP
    !set .map_pos_hi_tmp = ROW_MAP_POS_HI_TMP
    !set .pixel_pos_lo_tmp = ROW_PIXEL_POS_LO_TMP
    !set .pixel_pos_hi_tmp = ROW_PIXEL_POS_HI_TMP
    !set .screen_pos_lo_tmp = ROW_SCREEN_POS_LO_TMP
    !set .screen_pos_hi_tmp = ROW_SCREEN_POS_HI_TMP
    !set .color_pos_hi_tmp = ROW_COLOR_POS_HI_TMP
}
    lda TILE_COL
    sta .tile_col

    lda TILE_ROW
    sta .tile_row

    lda .map_pos_lo
    sta .map_pos_lo_tmp

    clc

    lda .map_pos_hi
    adc #>TILE_MAP
    clc
    sta .map_pos_hi_tmp

    lda .pixel_pos_hi
    adc #>BITMAP
    sta .pixel_pos_hi_tmp

    lda .pixel_pos_lo
    sta .pixel_pos_lo_tmp

    lda .screen_pos_hi
    adc #>SCREEN
    sta .screen_pos_hi_tmp

    lda .screen_pos_hi
    adc #>COLOR_RAM
    sta .color_pos_hi_tmp

    lda .screen_pos_lo
    sta .screen_pos_lo_tmp
}

;-------------------------------------------------------------------------------
;   the per frame slice of a column or row copy
;
;   A tile is TILE_COLS x TILE_ROWS screen chars, so walking the screen one char
;   at a time visits the sub chars of a tile in a fixed cycle before stepping on
;   to the next map byte.  Along a column copy (walking horizontally) the tile
;   row is fixed and the sub column cycles 0..TILE_COLS-1; along a row copy
;   (walking vertically) the tile column is fixed and the sub row cycles
;   0..TILE_ROWS-1.
;
;   Once the loop is unrolled by the cycle length and specialised on the fixed
;   coordinate, the sub char -- and so which copy_tile_charN to call -- is a
;   compile time constant per slot.  That removes, per char, the recomputation of
;   tile_row*TILE_COLS + tile_col, the cmp/bne chain that turned it into a call,
;   and all of the sub char bookkeeping in the old iterate_src_ptrs.  The
;   map byte is shared by every slot of a tile, so it is now fetched once per
;   tile rather than once per char.
;
;   A frame boundary can fall anywhere in the cycle, so the loop is entered at
;   the slot the previous frame stopped on and every slot has an exit that
;   records where to resume.  The invariant across frames is that the saved map
;   pointer addresses the tile containing the *next* slot to copy, which is why
;   the slot 0 exit -- the one that means "tile finished" -- steps it on.
;
;   Slot and exit bodies are deliberately uniform in size so that a slot can be
;   reached as .slots + n*SLOT_SIZE; both are asserted below.
;-------------------------------------------------------------------------------

; one unrolled slot of a tile
!macro tile_slot .stride, .char, .next_exit {
    +jsr_copy_tile_char .char
    clc
    +iterate_dst_ptrs .stride
    dec ITERATIONS
    +jeq .next_exit
}

; the loop specialised on one value of the copy's fixed tile coordinate
!macro tile_variant .stride, .fixed, .epilogue {
!if .stride = 1 {
    !set .period = TILE_COLS
    !set .phase  = COL_TILE_COL       ; sub column, cycles
} else {
    !set .period = TILE_ROWS
    !set .phase  = ROW_TILE_ROW       ; sub row, cycles
}
    ; aim both map reads at the tile the prologue staged
    lda MAP_POS_LO_TMP
    sta .map_entry+1
    sta .map_loop+1
    lda MAP_POS_HI_TMP
    sta .map_entry+2
    sta .map_loop+2

    ; resume where the previous frame stopped
    lda .phase
.map_entry
    ldx TILE_MAP                    ; does not disturb a
    !for .s, 0, .period-1 {
        !if .s != .period-1 {
            cmp #.s
            bne +
        }
        jmp .slots + .s * (.slot1 - .slots)
+
    }

.tile_loop
.map_loop
    ldx TILE_MAP                    ; one map byte serves every slot of the tile
.slots
    !for .s, 0, .period-1 {
        !if .s = 1 {
.slot1
        }
        !if .stride = 1 {
            !set .char = .fixed * TILE_COLS + .s
        } else {
            !set .char = .s * TILE_COLS + .fixed
        }
        +tile_slot .stride, .char, .exits + ((.s+1) % .period) * (.exit1 - .exits)
    }
.slots_end
    ; tile done, step to the next map byte
!if .stride = 1 { inc .map_loop+1 } else { inc .map_loop+2 }
    jmp .tile_loop

.exits
    !for .s, 0, .period-1 {
        !if .s = 1 {
.exit1
        }
        lda #.s
        sta .phase
        !if .s = 0 { jmp .finish_tile } else { jmp .finish }
    }
.exits_end

.finish_tile
    ; the tile was completed, so the next frame starts on the following one
!if .stride = 1 { inc .map_loop+1 } else { inc .map_loop+2 }
.finish
    lda .map_loop+1
    sta MAP_POS_LO_TMP
    lda .map_loop+2
    sta MAP_POS_HI_TMP
    jmp .epilogue

!if .slots_end - .slots != .period * (.slot1 - .slots) {
    !error "tile slots are not uniformly sized"
}
!if .exits_end - .exits != .period * (.exit1 - .exits) {
    !error "tile exits are not uniformly sized"
}
}

; Expects the char count for this frame already in ITERATIONS -- copy_*_tiles1
; and copy_*_tiles2 differ only in that count, and expanding the unrolled loop
; once per entry point costs about 900 bytes of the code segment for nothing.
!macro copy_tile_chars .stride {
!if .stride = 1 {
    !set .tile_col_tmp = COL_TILE_COL
    !set .tile_row_tmp = COL_TILE_ROW
    !set .map_pos_lo_tmp = COL_MAP_POS_LO_TMP
    !set .map_pos_hi_tmp = COL_MAP_POS_HI_TMP
    !set .pixel_pos_lo_tmp = COL_PIXEL_POS_LO_TMP
    !set .pixel_pos_hi_tmp = COL_PIXEL_POS_HI_TMP
    !set .screen_pos_lo_tmp = COL_SCREEN_POS_LO_TMP
    !set .screen_pos_hi_tmp = COL_SCREEN_POS_HI_TMP
    !set .color_pos_hi_tmp = COL_COLOR_POS_HI_TMP
} else {
    !set .tile_col_tmp = ROW_TILE_COL
    !set .tile_row_tmp = ROW_TILE_ROW
    !set .map_pos_lo_tmp = ROW_MAP_POS_LO_TMP
    !set .map_pos_hi_tmp = ROW_MAP_POS_HI_TMP
    !set .pixel_pos_lo_tmp = ROW_PIXEL_POS_LO_TMP
    !set .pixel_pos_hi_tmp = ROW_PIXEL_POS_HI_TMP
    !set .screen_pos_lo_tmp = ROW_SCREEN_POS_LO_TMP
    !set .screen_pos_hi_tmp = ROW_SCREEN_POS_HI_TMP
    !set .color_pos_hi_tmp = ROW_COLOR_POS_HI_TMP
}
!if .stride = 1 {
    !set .fixed_coordinate  = .tile_row_tmp  ; tile row is fixed along a column copy
    !set .variant_count = TILE_ROWS
} else {
    !set .fixed_coordinate  = .tile_col_tmp  ; tile column is fixed along a row copy
    !set .variant_count = TILE_COLS
}
    lda .map_pos_lo_tmp
    sta MAP_POS_LO_TMP

    lda .map_pos_hi_tmp
    sta MAP_POS_HI_TMP

    lda .screen_pos_lo_tmp
    sta SCREEN_POS_LO_TMP
    sta COLOR_POS_LO_TMP

    lda .screen_pos_hi_tmp
    sta SCREEN_POS_HI_TMP

    lda .color_pos_hi_tmp
    sta COLOR_POS_HI_TMP

    lda .pixel_pos_lo_tmp
    sta PIXEL_POS_LO_TMP

    lda .pixel_pos_hi_tmp
    sta PIXEL_POS_HI_TMP

    ; pick the loop specialised on this copy's fixed tile coordinate
    lda .fixed_coordinate
    !for .variant, 0, .variant_count-1 {
        !if .variant != .variant_count-1 {
            cmp #.variant
            bne +
        }
        jmp .variants + .variant * (.variant1 - .variants)
+
    }

.variants
    !for .variant, 0, .variant_count-1 {
        !if .variant = 1 {
.variant1
        }
        +tile_variant .stride, .variant, .epilogue
    }
.variants_end

!if .variants_end - .variants != .variant_count * (.variant1 - .variants) {
    !error "tile loop variants are not uniformly sized"
}

.epilogue
    lda MAP_POS_LO_TMP
    sta .map_pos_lo_tmp

    lda MAP_POS_HI_TMP
    sta .map_pos_hi_tmp

    lda SCREEN_POS_LO_TMP
    sta .screen_pos_lo_tmp

    lda SCREEN_POS_HI_TMP
    sta .screen_pos_hi_tmp

    lda COLOR_POS_HI_TMP
    sta .color_pos_hi_tmp

    lda PIXEL_POS_LO_TMP
    sta .pixel_pos_lo_tmp

    lda PIXEL_POS_HI_TMP
    sta .pixel_pos_hi_tmp
}

;-------------------------------------------------------------------------------
;   how a copy is split over its frames
;
;   copy_*_tiles1 runs once (it also does init_ptrs) and copy_*_tiles2 runs
;   the remaining COPY_*_FRAMES-1 times, so the per-frame counts have to add up
;   to the whole column/row exactly.  The "+ (remainder != 0)" term below is
;   added to *every* tiles2 call, not just the last one, so it only balances when
;   the remainder happens to be COPY_*_FRAMES-1 (or zero).  Anything else makes
;   tiles2 over-copy and walk past the end of the row -- assert instead of
;   trusting that the current tunables stay put.
;-------------------------------------------------------------------------------

COPY_COL_TILES1_COUNT = SCROLL_COLS / COPY_COL_FRAMES
COPY_COL_TILES2_COUNT = SCROLL_COLS / COPY_COL_FRAMES + ((SCROLL_COLS % COPY_COL_FRAMES) != 0)
COPY_ROW_TILES1_COUNT = SCROLL_ROWS / COPY_ROW_FRAMES
COPY_ROW_TILES2_COUNT = SCROLL_ROWS / COPY_ROW_FRAMES + ((SCROLL_ROWS % COPY_ROW_FRAMES) != 0)

!if COPY_COL_TILES1_COUNT + (COPY_COL_FRAMES-1) * COPY_COL_TILES2_COUNT != SCROLL_COLS {
    !error "COPY_COL_FRAMES (", COPY_COL_FRAMES, ") does not split SCROLL_COLS (", SCROLL_COLS, ") evenly: ", COPY_COL_TILES1_COUNT, " + ", COPY_COL_FRAMES-1, "*", COPY_COL_TILES2_COUNT, " chars would be copied"
}

!if COPY_ROW_TILES1_COUNT + (COPY_ROW_FRAMES-1) * COPY_ROW_TILES2_COUNT != SCROLL_ROWS {
    !error "COPY_ROW_FRAMES (", COPY_ROW_FRAMES, ") does not split SCROLL_ROWS (", SCROLL_ROWS, ") evenly: ", COPY_ROW_TILES1_COUNT, " + ", COPY_ROW_FRAMES-1, "*", COPY_ROW_TILES2_COUNT, " chars would be copied"
}

; +scroll_axis fires the trigger 4/SCROLL_SPEED frames before the hard step, and
; the copy has to be finished by then or a half-built row scrolls into view
COPY_FRAMES_BUDGET = 4 / SCROLL_SPEED

!if COPY_COL_FRAMES > COPY_FRAMES_BUDGET {
    !error "COPY_COL_FRAMES (", COPY_COL_FRAMES, ") exceeds the ", COPY_FRAMES_BUDGET, " frames a soft scroll leaves at SCROLL_SPEED ", SCROLL_SPEED
}

!if COPY_ROW_FRAMES > COPY_FRAMES_BUDGET {
    !error "COPY_ROW_FRAMES (", COPY_ROW_FRAMES, ") exceeds the ", COPY_FRAMES_BUDGET, " frames a soft scroll leaves at SCROLL_SPEED ", SCROLL_SPEED
}

; the "bne always" below relies on this
!if COPY_COL_TILES1_COUNT = 0 or COPY_ROW_TILES1_COUNT = 0 {
    !error "a first frame char count is 0"
}

copy_col_tiles1 !zone {
    +init_ptrs 1
    lda #COPY_COL_TILES1_COUNT
    bne copy_col_tiles_body      ; always, the count is not 0
}

copy_col_tiles2 !zone {
    lda #COPY_COL_TILES2_COUNT
}

copy_col_tiles_body !zone {
    sta ITERATIONS
    +copy_tile_chars 1
    rts
}

copy_row_tiles1 !zone {
    +init_ptrs SCREEN_COLS
    lda #COPY_ROW_TILES1_COUNT
    bne copy_row_tiles_body      ; always, the count is not 0
}

copy_row_tiles2 !zone {
    lda #COPY_ROW_TILES2_COUNT
}

copy_row_tiles_body !zone {
    sta ITERATIONS
    +copy_tile_chars SCREEN_COLS
    rts
}

COPY_TILES !zone {
    ldy COL_COPY
    bne .check_copy_col_tiles1
    jsr COPY_ROW_TILES
    rts
.check_copy_col_tiles1
    dey
    sty COL_COPY
    cpy #COPY_COL_FRAMES-1
    bne .check_copy_col_tiles2
    jsr copy_col_tiles1
    rts
.check_copy_col_tiles2
    jsr copy_col_tiles2
    rts
}

COPY_ROW_TILES !zone {
    ldy ROW_COPY
    bne .check_copy_row_tiles1
    rts
.check_copy_row_tiles1
    dey
    sty ROW_COPY
    cpy #COPY_ROW_FRAMES-1
    bne .check_copy_row_tiles2
    jsr copy_row_tiles1
    rts
.check_copy_row_tiles2
    jsr copy_row_tiles2
    rts
}
