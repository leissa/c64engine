; The camera is clamped to the current area, so a scroll is refused once the window
; would show what lies outside it.  Only the scroll is skipped -- the CURRENT_SPRITE nudge
; below still happens either way, it is a debug aid and not part of the camera.
;
; init_screen calls SCROLL_L directly rather than going through here, so the
; startup fill is not clamped and does not have to be.
!macro scroll_towards_max .scroll, .lo, .hi, .max {
    lda .lo
    cmp #<.max
    lda .hi
    sbc #>.max
    bcs +                   ; camera is at the bound
    jsr .scroll
    lda .lo
    clc
    adc #SCROLL_SPEED
    sta .lo
    bcc +
    inc .hi
+
}

!macro scroll_towards_zero .scroll, .lo, .hi {
    lda .lo                 ; less than one step left?  compare against the step
    cmp #SCROLL_SPEED       ; rather than against zero, so an odd position cannot
    lda .hi                 ; step straight past it and wrap
    sbc #0
    bcc +                   ; camera is at the bound
    jsr .scroll
    lda .lo
    sec
    sbc #SCROLL_SPEED
    sta .lo
    bcs +
    dec .hi
+
}

JOYSTICK !zone {
!ifdef AUTOPILOT {
    ; -DAUTOPILOT=1 -DAUTOPILOT_FRAMES=n replaces the stick with the scripted pattern in
    ; AUTOPILOT_TBL for n frames and then freezes this routine completely: no scroll,
    ; no colour cycling.  The screen goes static, which is what makes a headless
    ; VICE run reproducible -- an exit screenshot taken while the engine is still
    ; animating depends on the exact cycle the emulator is stopped on and is not
    ; comparable between runs.  See tools/regress.sh.
AUTOPILOT_IDX = *+1
    ldx #0
    cpx #AUTOPILOT_FRAMES
    bcc .autopilot_go
    ; freeze the sprite flicker phase as well, or a clustered layout keeps
    ; changing which sprites are shown and the screenshot stops being repeatable
    lda #1
    sta AUTOPILOT_FROZEN
    rts
.autopilot_go
    inc AUTOPILOT_IDX
    lda AUTOPILOT_TBL, x         ; a = stick state; the ldx/inc below leave it alone
    ldx CURRENT_SPRITE
    inc SPRITE_COLOR_A, x
} else {
    ldx CURRENT_SPRITE
    inc SPRITE_COLOR_A, x

    lda CIA1_DATA_PORT_A
}
    asl
    asl
    asl

.fire
    asl
    pha
    bcs .r
    dec CURRENT_SPRITE
    bpl .r
    lda #SPRITES-1
    sta CURRENT_SPRITE

.r
    pla
    asl
    bcs .l

    pha
    +scroll_towards_max SCROLL_R, CAMERA_X_LO, CAMERA_X_HI, CAMERA_X_MAX
    pla

    ldx CURRENT_SPRITE
    inc SPRITE_X, x

.l
    asl
    bcs .d

    pha
    +scroll_towards_zero SCROLL_L, CAMERA_X_LO, CAMERA_X_HI
    pla

    ldx CURRENT_SPRITE
    dec SPRITE_X, x

.d
    asl
    bcs .u

    pha
    +scroll_towards_max SCROLL_D, CAMERA_Y_LO, CAMERA_Y_HI, CAMERA_Y_MAX
    pla

    ldx CURRENT_SPRITE
    ldy SPRITE_Y, x
    cpy #SPRITE_WRAP_BOT
    beq .u
    inc SPRITE_Y, x

.u
    asl
    bcs .exit

    +scroll_towards_zero SCROLL_U, CAMERA_Y_LO, CAMERA_Y_HI

    ldx CURRENT_SPRITE
    ldy SPRITE_Y, x
    cpy #SPRITE_WRAP_TOP
    beq .exit
    dec SPRITE_Y, x

.exit
    rts
}

CURRENT_SPRITE
    !by SPRITES-1

!ifdef AUTOPILOT {
;-------------------------------------------------------------------------------
;   scripted stick pattern, one byte per frame
;
;   Exercises each direction on its own, both diagonals, and -- the case worth
;   watching -- direction reversals partway through a tile copy, where the copy
;   counter is re-seeded and the cursor jumps to the opposite edge while a copy
;   is still in flight.
;
;   Page aligned so lda AUTOPILOT_TBL,x never crosses a page and cannot perturb the
;   raster budget depending on where it lands.
;-------------------------------------------------------------------------------

; joystick bits, active low: 0=up 1=down 2=left 3=right 4=fire
AUTOPILOT_NONE = %11111111
AUTOPILOT_U    = %11111110
AUTOPILOT_D    = %11111101
AUTOPILOT_L    = %11111011
AUTOPILOT_R    = %11110111
AUTOPILOT_DR   = %11110101
AUTOPILOT_UL   = %11111010

!align 255, 0
AUTOPILOT_TBL
    ; 000-031 pure right
    !for .i, 0, 31 { !by AUTOPILOT_R }
    ; 032-063 pure down
    !for .i, 0, 31 { !by AUTOPILOT_D }
    ; 064-095 diagonal, both copies at once
    !for .i, 0, 31 { !by AUTOPILOT_DR }
    ; 096-127 reverse every frame
    !for .i, 0, 15 { !by AUTOPILOT_D, AUTOPILOT_U }
    ; 128-159 reverse every 2 frames
    !for .i, 0,  7 { !by AUTOPILOT_D, AUTOPILOT_D, AUTOPILOT_U, AUTOPILOT_U }
    ; 160-191 same on the other axis
    !for .i, 0,  7 { !by AUTOPILOT_R, AUTOPILOT_R, AUTOPILOT_L, AUTOPILOT_L }
    ; 192-223 diagonal reversal
    !for .i, 0,  7 { !by AUTOPILOT_DR, AUTOPILOT_DR, AUTOPILOT_UL, AUTOPILOT_UL }
    ; 224-255 idle
    !for .i, 0, 31 { !by AUTOPILOT_NONE }

!if AUTOPILOT_FRAMES > 256 {
    !error "AUTOPILOT_FRAMES (", AUTOPILOT_FRAMES, ") exceeds the ", 256, " entry AUTOPILOT_TBL"
}
}
