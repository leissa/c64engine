!cpu 6510               ; for illegal opcodes
!convtab scr            ; for conversion to c64 screen codes

;-------------------------------------------------------------------------------
; far branches
;-------------------------------------------------------------------------------

!macro jcc .target {
    bcs * + 5
    jmp .target
}

!macro jcs .target {
    bcc * + 5
    jmp .target
}

!macro jeq .target {
    bne * + 5
    jmp .target
}

!macro jne .target {
    beq * + 5
    jmp .target
}

!macro jmi .target {
    bpl * + 5
	jmp .target
}

!macro jpl .target {
    bmi * + 5
	jmp .target
}

!macro jvc .target {
    bvs * + 5
	jmp .target
}

!macro jvs .target {
    bvc * + 5
	jmp .target
}

;-------------------------------------------------------------------------------
; convenience branch pseudo opcodes
;-------------------------------------------------------------------------------

;
; borrow
;

; branch if borrow clear
!macro bbc .target {
    bcs .target
}

; branch if borrow set
!macro bbs .target {
    bcc .target
}

; long branch if borrow clear
!macro jbc .target {
    bcc * + 5
    jmp .target
}

; long branch if borrow set
!macro jbs .target {
    bcs * + 5
    jmp .target
}

;
; unsigned
;

; branch if below
!macro bult .target {
    bcc .target
}

; branch if below or equal
!macro bule .target {
    beq .target
    bcc .target
}

; branch if above
!macro bugt .target {
    beq +
    bcs .target
+
}

; branch if above or equal
!macro buge .target {
    bcs .target
}

;
; signed
;

; branch if less
!macro bslt .target {
    bmi .target
}

; branch if less or equal
!macro bsle .target {
    beq .target
    bmi .target
}

; branch if greater
!macro bsgt .target {
    beq .target
    bpl .target
}

; branch if greater or equal
!macro bsge .target {
    bpl .target
}

;-------------------------------------------------------------------------------
; skip jumps
;-------------------------------------------------------------------------------

!macro bcc {
.checkmark
    bcc +
+
    !if >.checkmark != >* {
        !warn "page boundary crossed"
    }
}

!macro bcs {
.checkmark
    bcs +
+
    !if >.checkmark != >* {
        !warn "page boundary crossed"
    }
}

!macro beq {
.checkmark
    beq +
+
    !if >.checkmark != >* {
        !warn "page boundary crossed"
    }
}

!macro bne {
.checkmark
    bne +
+
    !if >.checkmark != >* {
        !warn "page boundary crossed"
    }
}

!macro bpl {
.checkmark
    bpl +
+
    !if >.checkmark != >* {
        !warn "page boundary crossed"
    }
}

!macro bmi {
.checkmark
    bmi +
+
    !if >.checkmark != >* {
        !warn "page boundary crossed"
    }
}

!macro bvc {
.checkmark
    bvc +
+
    !if >.checkmark != >* {
        !warn "page boundary crossed"
    }
}

!macro bvs {
.checkmark
    bvs +
+
    !if >.checkmark != >* {
        !warn "page boundary crossed"
    }
}

;-------------------------------------------------------------------------------

!macro create_basic_starter .line, .start {
    ; here begins basic
    *=$0801

    ; end address of basic programm
    !word .end - 1

    ; line number of the basic line
    !word .line

    ; sys
    !by $9e

    ; find leading decimal digit of .start
    !set .divisor = 10000
    !set .digit = 0
    !do while .digit = 0 {
        !set .digit = .start / .divisor
        !set .start = .start % .divisor
        !set .divisor = .divisor / 10
    }

    !by '0' + .digit

    ; now output the rest
    !do while .divisor != 0 {
        !by '0' + .start / .divisor
        !set .start = .start % .divisor
        !set .divisor = .divisor / 10
    }
.end
}

!macro create_basic_starter .start {
    +create_basic_starter 42, .start
}

;-------------------------------------------------------------------------------

VECTOR_NMI   = $fffa
VECTOR_RESET = $fffc
VECTOR_IRQ   = $fffe

!macro save_regs .label {
    !set .offset = 3
    sta .label + .offset + 1
    stx .label + .offset + 3
    sty .label + .offset + 5
}

!macro ack_restore_rti {
    inc VIC_IRQ_STATUS
    lda #0
    ldx #0
    ldy #0
    rti
}

!macro sprite_line .v {
    !by .v>>16, (.v>>8)&255, .v&255
}

!macro flip_byte .v {
    !by ((.v & 1) << 7) | ((.v & 2) << 5) | ((.v & 4) << 3) | ((.v & 8) << 1) | ((.v & 16) >> 1) | ((.v & 32) >> 3) | ((.v & 64) >> 5) | ((.v & 128) >> 7)
}

!macro address .v {
    !by <.v, >.v
}

!macro clear_screen .v, .addr {
    ldx #0
    lda #.v
-
    sta .addr + $0000, x
    sta .addr + $0100, x
    sta .addr + $0200, x
    sta .addr + $0300, x
    dex
    bne -
}

!macro wait .cycles {
    !if .cycles = 0 {
        ; do nothing
    } else {
        !if .cycles = 1 {
            !error "does not work for an input value of 1"
        } else {
            !if .cycles % 2 = 0 {
                !for .i, 0, .cycles / 2 - 1 {
                    nop
                }
            } else {
                !for .i, 0, (.cycles-3) / 2 - 1 {
                    nop
                }
                bit $ea
            }
        }
    }
}

!macro wait_even .cycles {
    !if .cycles % 2 = 0 {
        +wait .cycles
    } else {
        +wait .cycles + 1
    }
}

!macro wait_loop .cycles {
    !set .in_loop = .cycles - 2 ; because of the ldy below
    !set .iterations = (.in_loop+1) / 5
    !set .rest = .in_loop - ((.iterations-1)* 5 + 4)

    !if .rest = 1 {
        !set .iterations = .iterations - 1
        !set .rest = .rest + 5
    }

    !if .iterations > 255 {
        !error "loop to large"
    }

    !if .iterations < 2 {
        +wait .cycles
    } else {
        ldy # .iterations
-       ; here are (iterations-1)*5 + 4 cycles
        dey
        bne -

        !set .rest = .in_loop - ((.iterations-1)* 5 + 4)
        +wait .rest
    }
}

RAM_ROM_SELECTION = $01
RAM_ROM_DEFAULT   = %00110111
ALL_RAM_WITH_IO   = %00110101
ALL_RAM           = %00110100

!macro set .v, .addr {
    lda #.v
    sta .addr
}

!macro set16 .v, .addr {
    lda #<.v
    sta .addr
    lda #>.v
    sta .addr+1
}

!macro copy .src, .dst {
    lda .src
    sta .dst
}

!macro copy_x .src, .dst {
    ldx .src
    stx .dst
}

!macro copy_y .src, .dst {
    ldy .src
    sty .dst
}

BCS_OPCODE = $b0
BCC_OPCODE = $90

!macro rsub .v {
    eor #$ff
    sec
    adc .v
}

;-------------------------------------------------------------------------------
; assert
;-------------------------------------------------------------------------------

!macro assert .v, .addr {
    lda .addr
    cmp #.v
    beq +
    jam
+
}
